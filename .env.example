# ==============================================================================
# PumpSentinel Configuration Example
# Copy this file to .env and configure with your local values.
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL via Docker Compose or local instance)
# Note: connection_limit is tuned for 8 GB RAM machines
DATABASE_URL="postgresql://pumpsentinel:sentinel_secret@localhost:5434/pumpsentinel?schema=public&connection_limit=5"

# Telegram Bot Credentials
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example
# Comma-separated list of Telegram user IDs permitted to issue commands
TELEGRAM_AUTHORIZED_USER_IDS=123456789,987654321

# Solana Ingestion & RPC Endpoints (Helius / Standard Solana)
# Note: Never provide private keys; this bot strictly simulates trading!
SOLANA_RPC_HTTP_URL="https://api.mainnet-beta.solana.com"
SOLANA_RPC_WS_URL="wss://api.mainnet-beta.solana.com"
PUMP_FUN_PROGRAM_ID="6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P"

# Helius RPC (Optional, recommended for production reliability)
# HELIUS_API_KEY="your-helius-api-key"
# HELIUS_RPC_HTTP_URL="https://mainnet.helius-rpc.com/?api-key=your-helius-api-key"
# HELIUS_RPC_WS_URL="wss://mainnet.helius-rpc.com/?api-key=your-helius-api-key"

# Request Throttling & Connection Resilience
RPC_MAX_REQUESTS_PER_SECOND=10
RPC_TIMEOUT_MS=10000
RPC_MAX_RETRIES=3
POLLING_INTERVAL_MS=5000
DEDUPLICATION_CACHE_SIZE=5000
DEDUPLICATION_TTL_MS=300000

# Token Analysis Data Service Constraints
ANALYSIS_RPC_BUDGET_PER_TOKEN=8
ANALYSIS_MAX_CONCURRENCY=3

# Paper Trading Simulation Parameters
PAPER_INITIAL_SOL_BALANCE=10.0
PAPER_MAX_SLIPPAGE_BPS=150
PAPER_SIMULATED_FEE_SOL=0.005

# Risk Engine Thresholds
RISK_MAX_TOP10_HOLDING_PCT=30.0
RISK_MAX_DEV_HOLDING_PCT=10.0
RISK_MIN_LIQUIDITY_SOL=15.0

# Memory Optimization (tuned for 8 GB RAM laptop)
# Maximum number of tokens/holders kept in active memory cache
MAX_CACHE_TOKENS=500
